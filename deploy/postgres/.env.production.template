# =============================================================================
# HarnessOS — production env (Contabo VPS + shared Postgres)
# Copy to ~/.archon/.env on the host, OR to a `.env` next to docker-compose,
# and edit the placeholders below.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres on the shared Contabo instance)
# -----------------------------------------------------------------------------
# Schema below assumes:
#   - Postgres is at 213.199.32.229:5433 (the vanilla shared instance —
#     NOT 5432 which only exposes the `tta` DB for the Becker Ecommerce app).
#   - You created a database named `harnessos` (CREATE DATABASE harnessos;).
#   - You created a role `archon` with login + password + GRANT ALL on
#     `harnessos`. From the postgres superuser:
#         CREATE ROLE archon WITH LOGIN PASSWORD '<SET-ME>';
#         GRANT ALL PRIVILEGES ON DATABASE harnessos TO archon;
#         \c harnessos
#         GRANT ALL ON SCHEMA public TO archon;
#         CREATE EXTENSION IF NOT EXISTS pgcrypto;   -- required for gen_random_uuid()
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://archon:SET_ME_PASSWORD@213.199.32.229:5433/harnessos

# -----------------------------------------------------------------------------
# AI provider (Pi, pointing at MiniMax M3)
# -----------------------------------------------------------------------------
# Sourced from the TTA project (https://app.TTA.com/user-profile). NEVER
# commit this file with a real key — even to a private repo. The server
# fails closed if MINIMAX_API_KEY is missing or empty.
MINIMAX_API_KEY=sk-cp-...SET_ME
DEFAULT_AI_ASSISTANT=pi
# Tier model ids — these are the canonical M3 identifier. Confirm in
# ~/.earendil-works/pi-ai/dist/providers/minimax.models.js after a Pi
# install/upgrade if M3 is renamed upstream.
ARCHON_TIER_LARGE_PROVIDER=pi
ARCHON_TIER_LARGE_MODEL=minimax/MiniMax-M3
ARCHON_TIER_SMALL_PROVIDER=pi
ARCHON_TIER_SMALL_MODEL=minimax/MiniMax-M3

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
MAX_CONCURRENT_CONVERSATIONS=10
SESSION_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Web auth (Better Auth) — opt-in. Leave empty to skip web login.
# -----------------------------------------------------------------------------
# BETTER_AUTH_SECRET=SET_ME_64_HEX_CHARS   # openssl rand -hex 32

# -----------------------------------------------------------------------------
# Optional platform adapters (Slack/Telegram/GitHub/Discord)
# Set only the ones you actually want. Empty = disabled.
# -----------------------------------------------------------------------------
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...
# GITHUB_TOKEN=ghp_...
# GITHUB_WEBHOOK_SECRET=...
# GITHUB_APP_ID=...
# GITHUB_APP_PRIVATE_KEY=...
# GITHUB_APP_INSTALLATION_ID=...

# -----------------------------------------------------------------------------
# Memory + RAG (path B)
# -----------------------------------------------------------------------------
# Set to "1" to enable the M3 LLM classifier that upgrades the auto-routing
# from pure heuristic to LLM-augmented when the heuristic is uncertain.
# Off by default (preserves the existing install's behavior).
# MEMORY_LLM_CLASSIFIER_ENABLED=1

# -----------------------------------------------------------------------------
# Anonymous telemetry — off in production by default
# -----------------------------------------------------------------------------
# Set to "1" to opt back in (maintainers use it to count active installs).
# ARCHON_TELEMETRY_DISABLED=1
